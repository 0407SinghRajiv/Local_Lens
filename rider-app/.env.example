# Rider App Environment Configuration
# Copy this file to .env and fill in your Supabase credentials
# These are the SAME credentials used by the Traveler app (same Supabase project)

# Supabase Credentials (Project Settings -> API)
# These must match the Traveler app's Supabase project exactly
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Web Client ID (same as Traveler app — from Google Cloud Console)
# Needed for native Google Sign-In on Android
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
