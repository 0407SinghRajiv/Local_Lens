# Backend Local Environment Variables
PROJECT_NAME="LocalLens API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration
POSTGRES_USER=locallens_user
POSTGRES_PASSWORD=locallens_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=locallens_db
DATABASE_URL=postgresql://locallens_user:locallens_password@localhost:5432/locallens_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party External APIs
MAP_API_KEY=
WEATHER_API_KEY=
LLM_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]
