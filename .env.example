# ==============================================
# LocalLens Root Environment Configuration Template
# Copy this file to .env before starting services
# ==============================================

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_DB=locallens_db
POSTGRES_USER=locallens_user
POSTGRES_PASSWORD=locallens_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://locallens_user:locallens_password@localhost:5432/locallens_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security / Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party External APIs
MAP_API_KEY=
WEATHER_API_KEY=
LLM_API_KEY=

# Backend Application Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Application Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
