# ==============================================================================
# LocalLens / Traveler Web Master Unified Environment Configuration Template
# Copy this file to .env before starting services
# ==============================================================================

PROJECT_NAME="LocalLens API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=locallens_user
POSTGRES_PASSWORD=locallens_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=locallens_db
DATABASE_URL=postgresql://locallens_user:locallens_password@localhost:5432/locallens_db

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Security / Authentication / JWT
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Next.js Public Supabase Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# Weather API (OpenWeatherMap)
# ------------------------------------------------------------------------------
WEATHER_API_KEY=your_weather_api_key
OPENWEATHER_API_KEY=your_weather_api_key
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_weather_api_key

# ------------------------------------------------------------------------------
# Groq AI Inference Engine
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Gemini Recommendation Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Nugen AI Integration (Post-generation verification & refinement)
# ------------------------------------------------------------------------------
NUGEN_ENABLED=false
NUGEN_API_KEY=your_nugen_api_key
NUGEN_MODEL=nugen-flash-instruct
NUGEN_API_URL=

# ------------------------------------------------------------------------------
# Maps, Geocoding & OAuth
# ------------------------------------------------------------------------------
MAP_API_KEY=
GEOCODING_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_WEB_CLIENT_ID=

# ------------------------------------------------------------------------------
# ML Microservice Serving
# ------------------------------------------------------------------------------
MODEL_DIR=./ml/models
DATASET_DIR=./ml/datasets
ML_HOST=0.0.0.0
ML_PORT=8001

# ------------------------------------------------------------------------------
# Application URLs, CORS & Routing
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
TRAVELER_API_URL=http://localhost:8000
PROVIDER_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001"]
